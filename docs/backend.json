
{
  "entities": {
    "Campaign": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campaign",
      "type": "object",
      "description": "Represents a Dungeons & Dragons 5e campaign, which is a series of interconnected sessions played by a group. It encapsulates the overarching narrative and world setting.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Campaign entity."
        },
        "name": {
          "type": "string",
          "description": "The official name of the campaign."
        },
        "description": {
          "type": "string",
          "description": "A detailed overview and synopsis of the campaign's premise, overarching goals, and themes."
        },
        "settingDetails": {
          "type": "string",
          "description": "A comprehensive description of the world setting, including its history, cultures, major geographical features, and relevant lore that defines the campaign's universe."
        },
        "dateCreated": {
          "type": "string",
          "description": "Timestamp indicating when the campaign record was created.",
          "format": "date-time"
        },
        "dateLastModified": {
          "type": "string",
          "description": "Timestamp indicating when the campaign record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "settingDetails",
        "dateCreated",
        "dateLastModified"
      ]
    },
    "Faction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Faction",
      "type": "object",
      "description": "Represents a group or organization within the campaign world with its own distinct goals, motivations, and level of influence.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Faction entity."
        },
        "campaignId": {
          "type": "string",
          "description": "Reference to the Campaign this faction belongs to."
        },
        "name": {
          "type": "string",
          "description": "The name of the faction."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the faction."
        },
        "alignment": {
          "type": "string",
          "description": "The moral and ethical alignment of the faction."
        },
        "powerLevel": {
          "type": "string",
          "description": "Indicates the level of influence or power the faction holds."
        },
        "agendas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dateCreated": {
          "type": "string",
          "format": "date-time"
        },
        "dateLastModified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "campaignId",
        "name",
        "description",
        "alignment",
        "powerLevel",
        "agendas",
        "dateCreated",
        "dateLastModified"
      ]
    },
    "Npc": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Npc",
      "type": "object",
      "description": "Represents a Non-Player Character (NPC) crucial to the campaign.",
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "race": {
          "type": "string"
        },
        "dndClass": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "backstory": {
          "type": "string"
        },
        "alignment": {
          "type": "string"
        },
        "motivations": {
          "type": "string"
        },
        "secrets": {
          "type": "string"
        },
        "tokenImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "roll20Macro": {
          "type": "string"
        },
        "factionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dateCreated": {
          "type": "string",
          "format": "date-time"
        },
        "dateLastModified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "campaignId",
        "name",
        "race",
        "dndClass",
        "description",
        "backstory",
        "alignment",
        "motivations",
        "secrets",
        "factionIds",
        "dateCreated",
        "dateLastModified"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents a specific place in the campaign world.",
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mapImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dominantFactionId": {
          "type": "string"
        },
        "dateCreated": {
          "type": "string",
          "format": "date-time"
        },
        "dateLastModified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "campaignId",
        "name",
        "type",
        "description",
        "features",
        "dateCreated",
        "dateLastModified"
      ]
    },
    "Session": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Session",
      "type": "object",
      "description": "Represents a single game session.",
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sessionNumber": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "datePreparedOrPlayed": {
          "type": "string",
          "format": "date-time"
        },
        "worldContextSummary": {
          "type": "string"
        },
        "mapDescription": {
          "type": "string"
        },
        "mapImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "involvedFactionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "involvedNpcIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "involvedLocationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plotHooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeConflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "potentialDevelopments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexpectedComplication": {
          "type": "string"
        },
        "hiddenHook": {
          "type": "string"
        },
        "politicalIntrigueSummary": {
          "type": "string"
        },
        "dateCreated": {
          "type": "string",
          "format": "date-time"
        },
        "dateLastModified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "campaignId",
        "title",
        "sessionNumber",
        "description",
        "datePreparedOrPlayed",
        "worldContextSummary",
        "mapDescription",
        "involvedFactionIds",
        "involvedNpcIds",
        "involvedLocationIds",
        "plotHooks",
        "activeConflicts",
        "potentialDevelopments",
        "unexpectedComplication",
        "hiddenHook",
        "politicalIntrigueSummary",
        "dateCreated",
        "dateLastModified"
      ]
    },
    "Battlemap": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Battlemap",
      "type": "object",
      "description": "Represents a tactical battlegrid map for encounters.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "prompt": { "type": "string" },
        "terrain": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "imageUrl", "ownerId", "createdAt"]
    },
    "Route": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Route",
      "type": "object",
      "description": "Represents a path or connection between locations.",
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "distanceKm": { "type": "number" },
        "terrainType": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "from", "to", "ownerId"]
    },
    "Quest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quest",
      "type": "object",
      "description": "Represents a quest or adventure hook in the campaign.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "hook": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "failed"] },
        "keyNpcs": { "type": "array", "items": { "type": "string" } },
        "keyLocations": { "type": "array", "items": { "type": "string" } },
        "rewards": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "hook", "objective", "ownerId", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "lastActiveSessionId": { "type": "string" }
            }
          },
          "description": "Root collection for all user-specific data."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}",
        "definition": {
          "entityName": "Campaign",
          "schema": {
            "$ref": "#/backend/entities/Campaign"
          },
          "description": "Stores individual D&D 5e campaigns owned by a specific user."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/factions/{factionId}",
        "definition": {
          "entityName": "Faction",
          "schema": {
            "$ref": "#/backend/entities/Faction"
          },
          "description": "Details about factions within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/npcs/{npcId}",
        "definition": {
          "entityName": "Npc",
          "schema": {
            "$ref": "#/backend/entities/Npc"
          },
          "description": "Details about NPCs within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/backend/entities/Location"
          },
          "description": "Details about locations within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/sessions/{sessionId}",
        "definition": {
          "entityName": "Session",
          "schema": {
            "$ref": "#/backend/entities/Session"
          },
          "description": "Details about individual game sessions within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/battlemaps/{mapId}",
        "definition": {
          "entityName": "Battlemap",
          "schema": {
            "$ref": "#/backend/entities/Battlemap"
          },
          "description": "Details about battlemaps within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/routes/{routeId}",
        "definition": {
          "entityName": "Route",
          "schema": {
            "$ref": "#/backend/entities/Route"
          },
          "description": "Details about regional routes within a specific campaign."
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/quests/{questId}",
        "definition": {
          "entityName": "Quest",
          "schema": {
            "$ref": "#/backend/entities/Quest"
          },
          "description": "Details about quests within a specific campaign."
        }
      }
    ]
  }
}
